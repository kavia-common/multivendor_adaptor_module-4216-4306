# Backend configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=CHANGE_ME

# Database connection (PostgreSQL)
# Prefer full URL:
DATABASE_URL=postgresql+psycopg2://appuser:dbuser123@localhost:5001/myapp
# Or individual parts (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5001
DB_NAME=myapp
DB_USER=appuser
DB_PASSWORD=dbuser123

# Auth/session
SESSION_TOKEN_TTL_SECONDS=86400

# CORS
CORS_ALLOW_ORIGINS=*

# Logging
LOG_LEVEL=INFO
